{
  "crons": [
    {
      "path": "/api/bookings/send-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/interview-notify",
      "schedule": "*/2 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/sms/webhook",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}

